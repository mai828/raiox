# Número do WhatsApp da equipe, formato internacional sem símbolos (55 + DDD + número). Ex.: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# URL que recebe o payload do lead (POST JSON). Vazio = modo local: o payload é apenas registrado no log do servidor.
QUIZ_WEBHOOK_URL=

# Link da política de privacidade exibido no consentimento.
NEXT_PUBLIC_PRIVACY_POLICY_URL=

# Opcionais. Se vazios, nenhum script de terceiros é carregado.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
